# Keep notebooks as-is (no EOL conversion)
*.ipynb -text

# Normalize text files to LF in repo
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.txt text eol=lf

# Images/binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.nc binary
data-clean/processed/*.nc filter=lfs diff=lfs merge=lfs -text
data-clean/downloads/*.zip filter=lfs diff=lfs merge=lfs -text
